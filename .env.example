# NetBox DCIM Configuration
NETBOX_URL=https://netbox.yourcompany.com
NETBOX_API_TOKEN=your_netbox_api_token_here

# CheckWarranty Configuration (Get your API key at https://checkwarranty.info/dashboard/api-keys)
CHECKWARRANTY_API_KEY=cw_live_your_api_key_here
CHECKWARRANTY_API_URL=https://checkwarranty.info/api/v1

# Optional Custom Field mappings in NetBox (defaults match NetBox conventions)
NETBOX_FIELD_WARRANTY_EXPIRATION=warranty_expiration
NETBOX_FIELD_WARRANTY_STATUS=warranty_status
NETBOX_FIELD_SUPPORT_TIER=support_tier
NETBOX_FIELD_WARRANTY_START=warranty_start_date
NETBOX_FIELD_SPECS=factory_specs

# Sync Options
DRY_RUN=false
LIMIT=50
RECHECK_DAYS=30
